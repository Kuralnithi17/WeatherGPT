# Copy this file to .env and choose one of the supported options.
# Paid hosted LLM (optional):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free local LLM (no paid credit required):
# Install Ollama first: https://ollama.com/download
# Then run: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Local PostgreSQL (start with: docker compose up -d db)
DATABASE_URL=postgresql://weathergpt:weathergpt_dev@localhost:5432/weathergpt
